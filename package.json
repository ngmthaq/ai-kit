{
  "name": "@ngmthaq20/ai-kit",
  "version": "0.0.28",
  "description": "Scaffold Claude-flavored agents, skills, and workflow templates into .claude/ or .github/ in your project.",
  "bin": {
    "ai-kit": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*": "prettier --check ."
  },
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "agents",
    "skills",
    "scaffold",
    "cli",
    "templates"
  ],
  "author": "ngmthaq20",
  "license": "ISC",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngmthaq/ai-kit.git"
  },
  "bugs": {
    "url": "https://github.com/ngmthaq/ai-kit/issues"
  },
  "homepage": "https://github.com/ngmthaq/ai-kit#readme",
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3"
  }
}
